NODE_ENV=development
PORT=3000

# HMAC secret dùng để ký access token. Bắt buộc set giá trị dài, ngẫu nhiên khi NODE_ENV=production.
API_TOKEN_SECRET=change-me-to-a-long-random-string

# Danh sách origin được phép gọi API, cách nhau bởi dấu phẩy. Để trống = cho phép mọi origin (chỉ dùng khi dev).
CORS_ORIGIN=

# Rate limit mặc định cho toàn bộ API.
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=60
